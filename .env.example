# ==============================================================================
# Creative Motion Studio — Environment Configuration
# Creator: Fahad Iqbal (Full-Stack Developer • Cybersecurity • AI Engineering)
# ==============================================================================

# Application Environment
NODE_ENV=production
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional External AI Creative Provider API
# Creative Motion Studio features a built-in heuristic creative engine that works
# out of the box without requiring any API keys. If you want to connect external LLMs
# (e.g. OpenAI or compatible endpoints), configure the variables below.
AI_API_KEY=
AI_API_ENDPOINT=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini

# Security Settings
# Maximum upload file size in bytes (Default: 8MB)
MAX_IMAGE_UPLOAD_BYTES=8388608
